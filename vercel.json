{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/work", "destination": "/portfolio", "permanent": true },
    { "source": "/work/:slug", "destination": "/portfolio/:slug", "permanent": true },
    { "source": "/allserviceshekayahaus", "destination": "/what-we-do", "permanent": true },
    { "source": "/services", "destination": "/what-we-do", "permanent": true },
    { "source": "/contact", "destination": "/contact-us", "permanent": true },
    { "source": "/insights", "destination": "/blogs", "permanent": true },
    { "source": "/insights/:slug", "destination": "/blogs/:slug", "permanent": true },
    { "source": "/join-the-haus", "destination": "/careers", "permanent": true },
    { "source": "/industries", "destination": "/what-we-do", "permanent": true }
  ],
  "headers": [
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
