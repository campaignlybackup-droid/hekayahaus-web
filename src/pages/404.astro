---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found | HekayaHaus" description="This page has moved or no longer exists." noindex>
  <section class="lost container">
    <p class="eyebrow eyebrow--accent">Error 404</p>
    <h1 class="h-mega" style="margin-top:24px">Unseen.</h1>
    <p class="lead" style="margin-top:28px">This page has moved, or the story ends here. Let’s get you somewhere worth being.</p>
    <div class="cta-actions">
      <Button href="/">Back to the Haus</Button>
      <Button href="/portfolio" variant="ghost">See the work</Button>
    </div>
  </section>
</Base>
