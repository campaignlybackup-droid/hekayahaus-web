---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
import Button from './Button.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const joinCurrent = nav.join.items.some((i) => isCurrent(i.href));
---
<header class="nav" id="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="HekayaHaus — home">
      <img src="/media/brand/h-mark-160.png" alt="" width="26" height="29" />
      <span>HEKAYAHAUS</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {nav.main.slice(0, 3).map((l) => (
        <a class="nav-link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <div class="dropdown" data-dropdown>
        <button class="nav-link" type="button" aria-expanded="false" aria-controls="join-panel" aria-current={joinCurrent ? 'page' : undefined}>
          {nav.join.label} <Icon name="chevron" />
        </button>
        <div class="dropdown-panel" id="join-panel">
          {nav.join.items.map((i) => (
            <a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}><strong>{i.label}</strong><span>{i.note}</span></a>
          ))}
        </div>
      </div>
      <a class="nav-link" href={nav.main[3].href} aria-current={isCurrent(nav.main[3].href) ? 'page' : undefined}>{nav.main[3].label}</a>
    </nav>
    <div class="nav-cta">
      <Button href={site.calendar} size="sm">Book a call</Button>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="menu-label">Menu</span>
        <span class="bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-label="Menu" data-lenis-prevent>
  <nav aria-label="Mobile">
    <a class="mm-link" href="/">Home <small>00</small></a>
    {nav.main.map((l, i) => (
      <a class="mm-link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label} <small>{String(i + 1).padStart(2, '0')}</small></a>
    ))}
    <div class="mm-sub">
      <span class="label">{nav.join.label}</span>
      {nav.join.items.map((i) => <a href={i.href}>{i.label}</a>)}
    </div>
  </nav>
  <div class="mm-foot">
    <Button href={site.calendar}>Book a discovery call</Button>
    <div class="mm-contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.whatsappUrl} target="_blank" rel="noopener">WhatsApp {site.whatsappDisplay}</a>
    </div>
  </div>
</div>
