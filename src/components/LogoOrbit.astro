---
import { logos } from '../data/site';
const mono = new Set(['Nike', 'Farak', 'Hero', 'EA Sports']);
const wide = new Set(['Farak']);
interface Props { label?: string }
const { label = 'Selected collaborations' } = Astro.props;
// two passes around the orbit for a fuller ring; the second pass is hidden from assistive tech
const ring = logos.map((l) => ({ ...l, dup: false }));
---
<div class="orbit-wrap">
  <ul class="orbit" role="list" aria-label={label} data-orbit>
    {ring.map((l) => (
      <li class:list={['logo', mono.has(l.name) && 'logo--mono', wide.has(l.name) && 'logo--wide', l.dup && 'orbit-dup']} aria-hidden={l.dup ? 'true' : undefined}>
        <img src={l.logo} alt={l.dup ? '' : l.name} width={l.w} height={l.h} loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
</div>
